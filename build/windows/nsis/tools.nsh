; Version/branding constants — kept in their own file so
; scripts/sync-release-version.sh can rewrite INFO_PRODUCTVERSION with a
; simple sed match, same pattern as build/darwin/Info.plist.
!define INFO_PRODUCTNAME "geckty"
!define INFO_COMPANYNAME "geckty contributors"
!define INFO_PRODUCTVERSION "0.0.0"
!define INFO_COPYRIGHT "(c) 2026, geckty contributors"
!define PRODUCT_EXECUTABLE "geckty.exe"
